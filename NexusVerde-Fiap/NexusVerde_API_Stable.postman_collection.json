          "mode": "raw",
            "raw": "{\\n  \\\"nome\\\": \\\"Reserva Florestal A\\\",\\n  \\\"bioma\\\": \\\"Amazonia\\\",\\n  \\\"estado\\\": \\\"RR\\\",\\n  \\\"pais\\\": \\\"Brasil\\\",\\n  \\\"latitude\\\": -2.5,\\n  \\\"longitude\\\": -60.5,\\n  \\\"areaKm2\\\": 1500.0\\n}"
        },
